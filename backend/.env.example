APP_NAME="BLC Surabaya"
APP_ENV=local
APP_KEY=

# Isi dengan: php artisan jwt:secret
JWT_SECRET=
# Masa berlaku token login (menit)
JWT_TTL=60
# Masa berlaku token hasil POST /auth/refresh (menit), default 2 minggu
JWT_REFRESH_TTL=20160
# Wajib aktif agar logout/refresh mencabut token yang masih berlaku
JWT_BLACKLIST_ENABLED=true
JWT_LEEWAY=0
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

FRONTEND_URL=http://127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file


BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=blc_surabaya
DB_USERNAME=postgres
DB_PASSWORD=123456

SANCTUM_EXPIRATION=1440

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true hanya bila aplikasi diakses lewat HTTPS
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
